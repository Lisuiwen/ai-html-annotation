# IDE used when Inspector jumps to source.
# Copy this file to .env in the same directory and adjust for your machine; .env is not committed.

# Option 1: a single CLI name on PATH (no extra arguments)
CODE_EDITOR=cursor
# CODE_EDITOR=code
# CODE_EDITOR=idea
# CODE_EDITOR=webstorm

# Option 2: absolute path to the executable (recommended on Windows when the CLI is a .cmd shim)
# Windows example:
# CODE_EDITOR="C:\\Users\\you\\AppData\\Local\\Programs\\cursor\\Cursor.exe"
# Mac example:
# CODE_EDITOR=/Applications/Cursor.app/Contents/MacOS/Cursor
