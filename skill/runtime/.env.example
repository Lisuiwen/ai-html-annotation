# Inspector 跳转源码时使用的 IDE。
# 复制本文件为同目录 .env 后按本机修改；.env 不提交。

# 方式一：PATH 中的单个 CLI 名（不支持附带参数）
CODE_EDITOR=cursor
# CODE_EDITOR=code
# CODE_EDITOR=codebuddy
# CODE_EDITOR=workbuddy

# 方式二：可执行文件绝对路径（Windows 下 CLI 为 .cmd 时推荐）
# Windows 示例：
# CODE_EDITOR=D:\Apps\CodeBuddy\CodeBuddy.exe
# Mac 示例：
# CODE_EDITOR=/Applications/Cursor.app/Contents/Resources/app/bin/cursor
